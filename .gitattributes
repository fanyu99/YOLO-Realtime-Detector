# =============================================================================
# 换行符与文本/二进制属性
#
# 文本文件一律以 LF 存入仓库，检出时也保持 LF，避免跨平台协作时
# 出现「整个文件都变了」的伪 diff。
# =============================================================================

* text=auto eol=lf

# -----------------------------------------------------------------------------
# 源码 / 文档（显式声明为文本）
# -----------------------------------------------------------------------------
*.cpp           text
*.h             text
*.hpp           text
*.qml           text
*.qrc           text
*.cmake         text
*.txt           text
*.md            text
*.json          text
CMakeLists.txt  text

# -----------------------------------------------------------------------------
# 二进制资源（禁止换行符转换，也不参与文本 diff）
# -----------------------------------------------------------------------------
*.onnx          binary
*.ort           binary
*.jpg           binary
*.jpeg          binary
*.png           binary
*.bmp           binary
*.webp          binary
*.mp4           binary
*.avi           binary
*.dll           binary
*.exe           binary
*.lib           binary
*.pdb           binary
