{
  "version": 3,
  // 入库文件：只描述「怎么构建」，不描述「依赖装在哪台机器的哪个目录」。
  // 所有第三方依赖目录都由 CMakeLists.txt 从环境变量读取，见 README「编译构建」。
  // 本机特有的绝对路径写在不入库的 CMakeUserPresets.json 里。
  "configurePresets": [
    {
      "hidden": true,
      "name": "Qt",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}"
      },
      "vendor": {
        "qt-project.org/Qt": {
          "checksum": "wVa86FgEkvdCTVp1/nxvrkaemJc="
        }
      }
    },
    {
      "hidden": true,
      "name": "base",
      "displayName": "通用基础配置",
      "inherits": "Qt",
      // external 策略 = 不改动工具链环境，要求在 MSVC 开发者终端（vcvars64）里执行。
      "generator": "Ninja",
      "architecture": {
        "strategy": "external",
        "value": "x64"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (x64)",
      "description": "Debug 构建 + OpenCV Debug 包；依赖目录取自环境变量 QTDIR / YOLO_OPENCV_DEBUG_DIR 等",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        // 代码里的默认值是 OFF，Debug 构建必须显式打开，否则会链到 OpenCV Release 库。
        "YOLO_BUILD_DEBUG": "ON",
        "CMAKE_CXX_FLAGS": "-DQT_QML_DEBUG"
      },
      "environment": {
        "QML_DEBUG_ARGS": "-qmljsdebugger=file:{467a6285-a183-4dc4-b6b5-a8656f3204a0},block"
      }
    },
    {
      "name": "release",
      "displayName": "Release (x64)",
      "description": "Release 构建 + OpenCV Release 包；依赖目录取自环境变量 QTDIR / YOLO_OPENCV_RELEASE_DIR 等",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "YOLO_BUILD_DEBUG": "OFF"
      }
    }
  ],
  "vendor": {
    "qt-project.org/Presets": {
      "checksum": "67SmY24ZeVbebyKD0fGfIzb/bGI="
    }
  }
}
